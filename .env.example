# =============================================================
# Variables para docker-compose.yml
# Copia este archivo a ".env" (mismo nombre, sin ".example") y
# no lo subas a Git: cada quien puede tener sus propios puertos.
# =============================================================

# --- Puertos expuestos en tu máquina ---
# Cámbialos solo si alguno ya está ocupado por otro programa tuyo.
APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
DB_DATABASE=portal_inmobiliario
DB_USERNAME=portal
DB_PASSWORD=portal_secret

# --- Migraciones automáticas al iniciar (true/false) ---
RUN_MIGRATIONS=true
