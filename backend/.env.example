# =============================================================
# Laravel — configuración de desarrollo (Docker)
#
# NO necesitas crear este archivo a mano: al arrancar, Docker
# copia .env.example -> .env y genera la APP_KEY automáticamente.
# Los valores DB_* y REDIS_* los sobrescribe docker-compose.yml,
# así que la fuente de verdad de las credenciales es el .env de la RAÍZ.
# =============================================================

APP_NAME="Portal Inmobiliario Global"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (host = nombre del servicio en docker-compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=portal_inmobiliario
DB_USERNAME=portal
DB_PASSWORD=portal_secret

# --- Redis (caché, sesiones y colas) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
