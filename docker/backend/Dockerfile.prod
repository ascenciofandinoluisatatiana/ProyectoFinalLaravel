# Imagen de PRODUCCIÓN para Laravel 13: PHP-FPM + opcache.
# Igual que la de desarrollo (Dockerfile) en extensiones y herramientas, pero:
#  - usa php-fpm (lo atiende nginx) en vez de "php artisan serve"
#  - usa la configuración de producción de PHP y opcache
# El código NO se copia a la imagen: docker-compose lo monta desde ./backend.
FROM php:8.4-fpm-bookworm

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/opt/composer \
    COMPOSER_CACHE_DIR=/opt/composer/cache \
    COMPOSER_MEMORY_LIMIT=-1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions pdo_pgsql redis zip opcache

# Configuración de producción de PHP (no muestra errores en pantalla) + ajustes de Umbral
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY php-prod.ini /usr/local/etc/php/conf.d/zz-umbral-prod.ini
COPY fpm-umbral.conf /usr/local/etc/php-fpm.d/zz-umbral.conf

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN git config --system --add safe.directory '*' \
    && mkdir -p /var/www/html/vendor /opt/composer/cache \
    && chmod -R 777 /var/www/html /opt/composer

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www/html
EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# -R: permite correr como root, igual que hoy, para no romper los permisos de storage/ (también lo escribe umbral_queue como root)
CMD ["php-fpm", "-R"]
