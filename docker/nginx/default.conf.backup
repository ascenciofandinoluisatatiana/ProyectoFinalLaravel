server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Nombre de servicios de Docker (para encontrar a "app")
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://app:8000;

    # Todo esto lo atiende Laravel: panel de admin, API y recursos del panel
    location ~ ^/(admin|api|assets|up)(/|$) {
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Todo lo demás es el frontend estático
    location / {
        try_files $uri $uri/ =404;
    }
}